    "browser": true,
    "icon": "mdi:face-woman-shimmer-outline",
    "service": {
      "implements": [
        "relifeluna"
      ],
      "required": [
        "database"
      ],
      "optional": [
        "console",
        "server",
        "chatluna"
      ]
    }
