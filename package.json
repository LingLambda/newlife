{
  "name": "koishi-plugin-relifeluna",
  "description": "RelifeLuna：为 OneBot 与 Milky 机器人切换身份预设（昵称、头像、个签、寒暄），提供 WebUI 与 ChatLuna 工具",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingLambda/relifeluna.git"
  },
  "bugs": {
    "url": "https://github.com/LingLambda/relifeluna/issues"
  },
  "homepage": "https://github.com/LingLambda/relifeluna#readme",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "tsx tests/index.ts"
  },
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "onebot",
    "milky",
    "relifeluna",
    "newlife",
    "身份",
    "换装"
  ],
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.4",
    "@koishijs/plugin-server": "^3.2.4",
    "koishi": "^4.18.7",
    "koishi-plugin-chatluna": "^1.4.0-alpha.43"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    },
    "@koishijs/plugin-server": {
      "optional": true
    },
    "koishi-plugin-chatluna": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.4",
    "@koishijs/plugin-console": "^5.30.4",
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-server": "^3.2.9",
    "koishi": "^4.18.7",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2"
  },
  "koishi": {
    "description": {
      "zh": "RelifeLuna：为 OneBot 与 Milky 机器人切换身份预设（昵称、头像、个签、寒暄），提供 WebUI 与 ChatLuna 工具",
      "en": "RelifeLuna: switch identity presets (nickname, avatar, bio, greeting) for OneBot and Milky bots, with WebUI and ChatLuna tools"
